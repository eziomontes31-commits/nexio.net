{
  "crons": [
    {
      "path": "/api/bot-run",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/administracion/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
